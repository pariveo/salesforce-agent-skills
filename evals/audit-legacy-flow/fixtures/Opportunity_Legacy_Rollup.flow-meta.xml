<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <actionCalls>
        <name>Send_Discount_Alert</name>
        <label>Send Discount Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>sales-ops@example.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Discounted opportunity</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>fxBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Add_To_Discounted</name>
        <label>Add To Discounted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Line_Item</targetReference>
        </connector>
        <assignmentItems>
            <assignToReference>discountTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Line_Items.TotalPrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Line_Items.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Discount reviewed</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Key_Account_Owner</name>
        <label>Is Key Account Owner?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Key_Account_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0055g00000AbCdEAAZ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Line_Items</targetReference>
            </connector>
            <label>Key Account Owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Discount</name>
        <label>Has Discount?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Discounted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Line_Items.Discount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_Discounted</targetReference>
            </connector>
            <label>Discounted</label>
        </rules>
    </decisions>
    <formulas>
        <name>fxBody</name>
        <dataType>String</dataType>
        <expression>&quot;Opportunity &quot; &amp; {!$Record.Name} &amp; &quot; has discounted lines worth &quot; &amp; TEXT({!discountTotal})</expression>
    </formulas>
    <formulas>
        <name>fxSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Discounted lines total: &quot; &amp; TEXT({!discountTotal})</expression>
    </formulas>
    <interviewLabel>Opportunity Legacy Rollup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Legacy Rollup</label>
    <loops>
        <name>Loop_Line_Items</name>
        <label>Loop Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Has_Discount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Opportunity</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Line_Items</name>
        <label>Get Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Line_Items</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Line_Item</name>
        <label>Update Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Line_Items</targetReference>
        </connector>
        <inputReference>Loop_Line_Items</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Discount_Alert</targetReference>
        </connector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fxSummary</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Key_Account_Owner</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>discountTotal</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
