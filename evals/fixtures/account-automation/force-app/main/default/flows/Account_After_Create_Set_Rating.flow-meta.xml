<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After save on create only, trigger order 20. Updates the new account's Rating to Cold, which saves the account again.</description>
