<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Account_Set_Rating_Hot</fullName>
        <field>Rating</field>
        <literalValue>Hot</literalValue>
        <name>Account Set Rating Hot</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Account_Set_Site_Flagged</fullName>
        <field>Site</field>
        <formula>&quot;Flagged&quot;</formula>
        <name>Account Set Site Flagged</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
    </fieldUpdates>
    <rules>
        <fullName>Account_Hot_Rating</fullName>
        <actions>
            <name>Account_Set_Rating_Hot</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.AnnualRevenue</field>
            <operation>greaterThan</operation>
            <value>1000000</value>
        </criteriaItems>
        <description>Sets Rating to Hot when AnnualRevenue is above 1,000,000. The field update re-evaluates workflow rules.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Account_Flag_Hot</fullName>
        <actions>
            <name>Account_Set_Site_Flagged</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Sets Site to Flagged on every save where Rating is Hot.</description>
        <formula>ISPICKVAL(Rating, &quot;Hot&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
