<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pattern: screen action behind an Action Button. The button runs an active
  autolaunched flow (Account_Count_Open_Opportunities) server-side and the
  result shows on the same screen, without Next.
  Shape notes:
  - screens.actions: the screen action (actionType flow, actionName and
    nameSegment = the autolaunched flow API name, inputParameters).
  - A ComponentInstance field with extensionName flowruntime:actionButtonField.
    Bind isSuccess, inProgress and errorMessage to <action>.IsSuccess,
    <action>.InProgress and <action>.ErrorMessage.
  - screens.triggers: eventName flow__screenfieldclick, eventSource = the button
    field, handlers.screenActionName = the action.
  - Read outputs as {!<action>.Results.<outputVariable>}.
  Action Button is GA since Winter '25 (API 62). Screen actions need API 59+.
  Verified: deployed on API 67.0 (Summer '26) with its called flow.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Screen flow with an Action Button that runs an autolaunched flow without leaving the screen.</description>
    <label>Account Check Pipeline Screen</label>
    <processType>Flow</processType>
    <status>Active</status>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Pipeline_Screen</targetReference></connector>
    </start>
    <screens>
        <name>Pipeline_Screen</name>
        <label>Pipeline Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actions>
            <name>Count_Open_Opportunities</name>
            <actionName>Account_Count_Open_Opportunities</actionName>
            <actionType>flow</actionType>
            <inputParameters>
                <name>accountId</name>
                <value><elementReference>recordId</elementReference></value>
            </inputParameters>
            <label>Count Open Opportunities</label>
            <nameSegment>Account_Count_Open_Opportunities</nameSegment>
        </actions>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Check_Button</name>
            <extensionName>flowruntime:actionButtonField</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters><name>label</name><value><stringValue>Check open pipeline</stringValue></value></inputParameters>
            <inputParameters><name>isSuccess</name><value><elementReference>Count_Open_Opportunities.IsSuccess</elementReference></value></inputParameters>
            <inputParameters><name>inProgress</name><value><elementReference>Count_Open_Opportunities.InProgress</elementReference></value></inputParameters>
            <inputParameters><name>errorMessage</name><value><elementReference>Count_Open_Opportunities.ErrorMessage</elementReference></value></inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;Open opportunities: {!Count_Open_Opportunities.Results.openOpportunityCount}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <triggers>
            <eventName>flow__screenfieldclick</eventName>
            <eventSource>Check_Button</eventSource>
            <handlers>
                <screenActionName>Count_Open_Opportunities</screenActionName>
            </handlers>
        </triggers>
    </screens>
    <variables><name>recordId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
</Flow>
