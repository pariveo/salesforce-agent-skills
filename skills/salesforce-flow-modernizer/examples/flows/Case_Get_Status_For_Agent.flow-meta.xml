<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pattern: autolaunched flow built to be an Agentforce agent action.
  - Autolaunched, no trigger. Agent custom actions reference autolaunched flows.
  - Every input and output variable has a description written as an
    instruction to the reasoning engine: what to pass, what comes back.
  - At least one output. Not-found and fault both end in a prescriptive
    output message instead of a failed interview.
  - Explicit queried fields, single-record Get with the empty case handled.
  Replaces: an invocable Apex class written only to wrap this logic for an agent.
  Verified: deployed and run on API 67.0 (Summer '26).
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Assign_Fault_Message</name>
        <label>Assign Fault Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The case lookup failed. Tell the user the status is unavailable right now and offer to create a follow-up task.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Found</name>
        <label>Assign Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>caseStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case.Status</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>caseSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case.Subject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Case found.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Not_Found</name>
        <label>Assign Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No case has this number. Ask the user to check the case number; do not guess one.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Dec_Case_Found</name>
        <label>Case Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Found</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Agent action: returns the status and subject of one case by its case number.</description>
    <interviewLabel>Case Get Status For Agent {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Get Status For Agent</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Dec_Case_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_Fault_Message</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CaseNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>caseNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Subject</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>caseNumber</name>
        <dataType>String</dataType>
        <description>The case number the user gave, exactly as written, for example 00001026. Ask the user for it if they have not provided one.</description>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>caseStatus</name>
        <dataType>String</dataType>
        <description>The case status to report to the user. Empty when resultMessage says the case was not found or the lookup failed.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>caseSubject</name>
        <dataType>String</dataType>
        <description>The case subject, to confirm with the user that this is the case they mean.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <description>What happened and what to do next. Always read this first and follow its instruction.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
