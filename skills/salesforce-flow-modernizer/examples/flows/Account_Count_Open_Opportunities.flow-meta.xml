<?xml version="1.0" encoding="UTF-8"?>
<!--
  Called by Account_Check_Pipeline_Screen as a screen action. Screen actions
  can only call active autolaunched flows. AssignCount on a Get Records
  collection counts without a Transform or a loop.
  Verified: deployed on API 67.0 (Summer '26).
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Returns the number of open opportunities for one account. Called as a screen action.</description>
    <label>Account Count Open Opportunities</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Open_Opportunities</targetReference></connector>
    </start>
    <recordLookups>
        <name>Get_Open_Opportunities</name>
        <label>Get Open Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>Opportunity</object>
        <filterLogic>and</filterLogic>
        <filters><field>AccountId</field><operator>EqualTo</operator><value><elementReference>accountId</elementReference></value></filters>
        <filters><field>IsClosed</field><operator>EqualTo</operator><value><booleanValue>false</booleanValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector><targetReference>Assign_Count</targetReference></connector>
    </recordLookups>
    <assignments>
        <name>Assign_Count</name>
        <label>Assign Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems><assignToReference>openOpportunityCount</assignToReference><operator>AssignCount</operator><value><elementReference>Get_Open_Opportunities</elementReference></value></assignmentItems>
    </assignments>
    <variables><name>accountId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>openOpportunityCount</name><dataType>Number</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><scale>0</scale></variables>
</Flow>
